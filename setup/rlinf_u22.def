Bootstrap: docker
From: ubuntu:22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        git git-lfs \
        curl wget \
        build-essential gcc g++ make cmake pkg-config \
        python3.11 python3.11-dev python3.11-venv \
        python3-pip \
        libssl-dev libffi-dev zlib1g-dev \
        libgl1-mesa-glx libgles2-mesa libegl1 \
        libvulkan1 libxrandr2 libxinerama1 libxcursor1 libxi6 \
        ffmpeg unzip zip \
        ca-certificates software-properties-common \
        && rm -rf /var/lib/apt/lists/*

    apt-get install -y libxt6 libglu1-mesa

    # Make python3.11 the default python/python3
    update-alternatives --install /usr/bin/python  python  /usr/bin/python3.11 1
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

    # Install pip for 3.11
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11

    # Install uv (what RLinf install.sh actually uses under the hood)
    curl -LsSf https://astral.sh/uv/install.sh | env HOME=/opt sh
    ln -s /opt/.local/bin/uv  /usr/local/bin/uv
    ln -s /opt/.local/bin/uvx /usr/local/bin/uvx

    # Pre-install Python 3.11.14 via uv so it's cached and available
    /usr/local/bin/uv python install 3.11.14

    # System-wide git-lfs (needed for model downloads)
    git lfs install --system

    mkdir -p /usr/share/vulkan/icd.d
    mkdir -p /usr/share/vulkan/implicit_layer.d
    touch /usr/share/vulkan/icd.d/nvidia_icd.json
    touch /usr/share/vulkan/implicit_layer.d/nvidia_layers.json

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PATH="/usr/local/bin:$PATH"
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%labels
    Author jshim12
    Description Ubuntu 22.04 base for RLinf + openpi + polaris/IsaacSim

%help
    Typical usage:
      apptainer shell --nv \
        --bind /scratch/cluster/jshim12:/scratch/cluster/jshim12 \
        rlinf_u22.sif
